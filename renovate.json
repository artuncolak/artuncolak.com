{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "groupName": "all dependencies",
  "separateMajorMinor": false,
  "groupSlug": "all",
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all"
    }
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "schedule": ["every 3 months on the first day of the month"],
  "extends": ["config:base"]
}
